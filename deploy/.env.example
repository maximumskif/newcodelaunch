# Copy to deploy/.env (gitignored) on the server. Read by Docker Compose for
# ${...} substitution in docker-compose.prod.yml — separate from
# backend/.env and services/candy-machine/.env, which hold the app secrets.
# deploy/bootstrap.sh generates all three.

# The domain (or <ip>.sslip.io, which works with no DNS setup) whose DNS
# points at this server. Caddy gets its HTTPS certificate for this name.
DOMAIN=launch.example.com
POSTGRES_PASSWORD=

# Optional browser-side RPC overrides, baked into the frontend bundle.
# These are public by nature, so use a key restricted to your domain.
VITE_SOLANA_RPC_URL=
VITE_SOLANA_DEVNET_RPC_URL=
VITE_SEPOLIA_RPC_URL=
VITE_ETHEREUM_RPC_URL=
VITE_POLYGON_AMOY_RPC_URL=
VITE_POLYGON_RPC_URL=
VITE_BSC_TESTNET_RPC_URL=
VITE_BSC_RPC_URL=

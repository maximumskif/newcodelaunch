# One origin for the whole app. Caddy obtains and renews the HTTPS
# certificate for $DOMAIN by itself (its DNS must already point here).
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:5000
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

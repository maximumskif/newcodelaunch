VITE_API_BASE_URL=http://localhost:5000/api

# RPC endpoints the *browser* uses (the connected wallet's reads, signing
# and broadcasting — separate from the backend's own SEPOLIA_RPC_URL etc.
# in backend/.env.example). All optional: leave one unset or empty and that
# network falls back to its public default (viem's per-chain default for
# EVM; api.mainnet-beta / api.devnet.solana.com for Solana). Public RPCs
# rate-limit hard — set real provider URLs (Alchemy/Infura/QuickNode/
# Helius/etc) before production traffic. These are baked into the static
# bundle at build time (see src/lib/rpcUrls.ts), so they're visible to
# anyone who loads the page: use a browser-safe key restricted to your
# domain in the provider's dashboard, never an unrestricted one.

# Solana Mainnet (also the wallet adapter's own connection, solanaWallets.tsx).
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Solana Devnet. e2e tests set this to a local solana-test-validator (see
# frontend/e2e/README.md).
VITE_SOLANA_DEVNET_RPC_URL=

# EVM — names mirror the backend's. e2e tests set VITE_SEPOLIA_RPC_URL to a
# local anvil instance (see frontend/e2e/README.md).
VITE_SEPOLIA_RPC_URL=
VITE_ETHEREUM_RPC_URL=
VITE_POLYGON_AMOY_RPC_URL=
VITE_POLYGON_RPC_URL=
VITE_BSC_TESTNET_RPC_URL=
VITE_BSC_RPC_URL=

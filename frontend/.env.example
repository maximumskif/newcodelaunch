VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional — overrides the wallet's own Sepolia RPC (wagmiConfig.ts), which
# otherwise uses viem's public default. Leave unset for normal dev/prod use;
# e2e tests set this to a local anvil instance (see frontend/e2e/README.md).
VITE_SEPOLIA_RPC_URL=

# Optional — overrides the wallet's own Solana Devnet RPC (candyMachineApi.ts),
# which otherwise defaults to the public devnet endpoint. Leave unset for
# normal dev/prod use; e2e tests set this to a local solana-test-validator.
VITE_SOLANA_DEVNET_RPC_URL=

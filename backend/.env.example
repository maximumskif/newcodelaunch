# Copy to backend/.env and fill in. This backend refuses to start if
# SECRET_KEY or JWT_SECRET_KEY is missing — see app/config.py. Nothing here
# has a real working default. Use two distinct values: JWT_SECRET_KEY used
# to fall back to SECRET_KEY when unset, meaning a leak of one secret
# compromised both Flask's own signing and every issued JWT.

FLASK_ENV=development
SECRET_KEY=generate-a-long-random-value
JWT_SECRET_KEY=generate-a-different-long-random-value
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600
WALLET_NONCE_TTL_SECONDS=300
# How long a background NFT-generation job can sit with no progress before
# `flask reap-stale-generation-jobs` treats it as abandoned (its running
# worker died) and marks it failed.
NFT_GENERATION_JOB_STALE_SECONDS=600
# How often scripts/maintenance-loop.sh (docker-compose.yml's `scheduler`
# service) runs `flask reap-stale-generation-jobs` and `flask prune-nonces`.
# Only read by that script, not by the app. Without the scheduler (or an
# equivalent cron job running `sh scripts/maintenance-loop.sh --once`),
# nothing runs either command. See docs/OPERATIONS.md.
MAINTENANCE_INTERVAL_SECONDS=300
# Structured (JSON) request logging — see app/logging_config.py.
LOG_LEVEL=INFO

DATABASE_URL=postgresql://launchpad:launchpad@localhost:5432/launchpad

CORS_ORIGINS=http://localhost:5173

# memory:// is fine for one dev process only — it silently breaks the
# moment this runs behind gunicorn with more than one worker (each worker
# gets its own counter, multiplying the real allowed rate by worker
# count). Point this at Redis before running more than one worker.
#
# The value below (redis://localhost:6379) is for running this backend
# directly on the HOST (`flask run`/gunicorn) against `docker compose up -d
# redis`'s host-published port — it works out of the box for that case only.
# If the backend ITSELF also runs inside docker-compose (the `backend`
# service in docker-compose.yml), "localhost" there resolves to the backend
# container, not the separate `redis` container — docker-compose.yml already
# overrides this env var to redis://redis:6379 (the compose service name)
# for that case, so you don't need to set it yourself there.
#   RATE_LIMIT_STORAGE_URI=redis://localhost:6379
RATE_LIMIT_STORAGE_URI=memory://

# Set this to the number of reverse-proxy hops in front of this app (a
# load balancer, a CDN) once one exists — 0 (the default) means the rate
# limiter trusts request.remote_addr as given, which is only correct when
# nothing sits in front of this app.
TRUSTED_PROXY_COUNT=0

# Public RPC endpoints — fine as-is for dev, swap for a dedicated provider (Alchemy/
# Infura/Helius/etc) before doing anything at real volume. Testnets are what the
# frontend defaults to (Phase 4: testnet-first) — mainnet still works, it's just
# not the default network and the UI requires an explicit confirmation to deploy to it.
# These are the backend's own reads (status checks, transaction verification,
# gas estimation); the browser's wallet RPCs are configured separately
# (VITE_*_RPC_URL in frontend/.env.example), and the Candy Machine sidecar's
# Solana RPCs separately again (services/candy-machine/.env.example) — point
# all three at the same provider in production. A blank value means "use the
# public default" (see config.py's _rpc_url_env), same as leaving it out.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_RPC_URL=https://eth.llamarpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Phase 6 (Market Intelligence / DeFi Scanner). COINGECKO_API_KEY is optional —
# leave blank for CoinGecko's public rate limit. MORALIS/SOLSCAN aren't used yet.
COINGECKO_API_KEY=
MORALIS_API_KEY=
SOLSCAN_API_KEY=

# Optional: "Verify source" on EVM deployments (Etherscan, Polygonscan, BscScan
# and their testnets) — one Etherscan key covers all of them via Etherscan's
# multichain V2 API. Get one at https://etherscan.io/myapikey. Leave blank to
# disable verification; deploying is unaffected.
ETHERSCAN_API_KEY=

# Candy Machine sidecar (services/candy-machine) — the secret must match that
# service's CANDY_MACHINE_SHARED_SECRET exactly.
CANDY_MACHINE_SERVICE_URL=http://localhost:4000
CANDY_MACHINE_SHARED_SECRET=change-me

# Pinata (Phase 3, NFT Generator "Publish" step) — the old app defaulted to
# Infura's IPFS pinning service, which no longer accepts new signups. Set
# either PINATA_JWT (preferred) or the legacy key/secret pair; check Pinata's
# current docs, since I couldn't verify which auth method is current for you.
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Optional — override Pinata's own API base URL / public gateway URL. Leave
# both unset for normal dev/prod use (or set PINATA_GATEWAY_URL to a
# dedicated gateway if you have one); the e2e suite points both at a local
# stub instead of a real Pinata account (see frontend/e2e/README.md).
PINATA_BASE_URL=
PINATA_GATEWAY_URL=

# AI Trait Identifier (Phase 3) — optional. Without it, trait analysis still
# runs (real color/composition/technical CV analysis), just without the
# AI-vision section.
OPENAI_API_KEY=

PORT=4000
CORS_ORIGINS=http://localhost:5173

# Shared secret the Flask backend must send as `x-internal-secret` on every
# request under /internal. Generate a long random value — never reuse SECRET_KEY.
CANDY_MACHINE_SHARED_SECRET=change-me

# Optional overrides — public endpoints are the default (see src/lib/umi.ts),
# fine for dev, swap for a dedicated provider before real volume.
SOLANA_DEVNET_RPC_URL=
SOLANA_MAINNET_RPC_URL=

# No CANDY_MACHINE_AUTHORITY_KEYPAIR_PATH here on purpose. This service never
# holds a platform-wide Solana authority key — every collection/candy machine
# is created and owned by the creator's own wallet, which signs client-side
# (see docs/REBUILD_PROGRESS.md's Candy Machine signer-model decision). This
# service only ever generates single-use, in-memory, throwaway keypairs for
# brand-new on-chain accounts (collection mint, candy machine) — never a
# keypair that retains any authority after the transaction that creates it.

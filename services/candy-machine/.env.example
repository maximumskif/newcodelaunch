PORT=4000
CORS_ORIGINS=http://localhost:5173

# Shared secret the Flask backend must send as `x-internal-secret` on every
# request under /internal. Generate a long random value — never reuse SECRET_KEY.
CANDY_MACHINE_SHARED_SECRET=change-me

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Set up in Phase 6, when real Metaplex calls are added. Never commit the actual
# keypair file — it holds the collection/candy-machine update authority.
CANDY_MACHINE_AUTHORITY_KEYPAIR_PATH=./authority-keypair.json
